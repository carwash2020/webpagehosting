{
  "name": "triplehenterprises-site-tests",
  "private": true,
  "description": "Automated tests and consistency checks for triplehenterprisesllc.biz. Dev-only tooling -- has no effect on the deployed static site, which still has zero build step.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "cd tests && node --test",
    "check-visual-snapshot": "node scripts/check-visual-snapshot.js",
    "check-consistency": "node scripts/check-consistency.js",
    "fix-versions": "node scripts/check-consistency.js --fix-versions",
    "check-undefined-vars": "node scripts/check-undefined-vars.js"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1"
  }
}
